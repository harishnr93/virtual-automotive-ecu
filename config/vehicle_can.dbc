VERSION "0.1.0"


NS_ :
	CM_
	BA_DEF_
	BA_
	VAL_
	BA_DEF_DEF_

BS_:

BU_: VehicleSim CruiseECU


BO_ 256 VehicleDynamics: 8 VehicleSim
 SG_ VehicleSpeed : 0|16@1+ (0.01,0) [0|300] "km/h" CruiseECU
 SG_ LongitudinalAccel : 16|16@1- (0.001,0) [-20|20] "m/s2" CruiseECU
 SG_ VehicleSpeedValid : 32|1@1+ (1,0) [0|1] "" CruiseECU
 SG_ AliveCounter : 56|4@1+ (1,0) [0|15] "" CruiseECU

BO_ 272 DriverInputs: 8 VehicleSim
 SG_ AcceleratorPedal : 0|8@1+ (0.5,0) [0|100] "%" CruiseECU
 SG_ BrakePedalPressed : 8|1@1+ (1,0) [0|1] "" CruiseECU
 SG_ CruiseMainSwitch : 9|1@1+ (1,0) [0|1] "" CruiseECU
 SG_ CruiseSetRequest : 10|1@1+ (1,0) [0|1] "" CruiseECU
 SG_ CruiseCancelRequest : 11|1@1+ (1,0) [0|1] "" CruiseECU
 SG_ DriverSetSpeed : 16|8@1+ (1,0) [0|200] "km/h" CruiseECU
 SG_ AliveCounter : 56|4@1+ (1,0) [0|15] "" CruiseECU

BO_ 512 CruiseControlStatus: 8 CruiseECU
 SG_ ThrottleCommand : 0|16@1+ (0.01,0) [0|100] "%" VehicleSim
 SG_ CruiseState : 16|3@1+ (1,0) [0|4] "" VehicleSim
 SG_ CruiseTargetSpeed : 24|8@1+ (1,0) [0|200] "km/h" VehicleSim
 SG_ AliveCounter : 56|4@1+ (1,0) [0|15] "" VehicleSim


CM_ "Virtual Automotive ECU Platform - educational CAN matrix (Classic CAN, 11-bit IDs). IDs 0x7E0/0x7E8 are reserved for UDS diagnostics over ISO-TP (Phase 4).";
CM_ BO_ 256 "Vehicle motion state published by the vehicle simulator.";
CM_ BO_ 272 "Driver pedal and cruise-control switch inputs.";
CM_ BO_ 512 "Cruise control ECU output and state.";
CM_ SG_ 256 AliveCounter "4-bit rolling counter, increments by 1 per transmission (mod 16).";
CM_ SG_ 272 AliveCounter "4-bit rolling counter, increments by 1 per transmission (mod 16).";
CM_ SG_ 512 AliveCounter "4-bit rolling counter, increments by 1 per transmission (mod 16).";
BA_DEF_ BO_ "GenMsgCycleTime" INT 0 10000;
BA_DEF_ BO_ "VECU_RxTimeoutMs" INT 0 10000;
BA_DEF_DEF_ "GenMsgCycleTime" 0;
BA_DEF_DEF_ "VECU_RxTimeoutMs" 0;
BA_ "GenMsgCycleTime" BO_ 256 20;
BA_ "VECU_RxTimeoutMs" BO_ 256 100;
BA_ "GenMsgCycleTime" BO_ 272 50;
BA_ "VECU_RxTimeoutMs" BO_ 272 250;
BA_ "GenMsgCycleTime" BO_ 512 20;
BA_ "VECU_RxTimeoutMs" BO_ 512 100;
VAL_ 512 CruiseState 0 "Off" 1 "Standby" 2 "Active" 3 "Override" 4 "Fault" ;
